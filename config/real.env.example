# Energy gateway real-mode configuration (placeholders only)
# Copy to .env only on a real deployment and replace every <placeholder>.

MODE=real
REAL_STRICT=true
LOG_LEVEL=INFO

MQTT_HOST=broker.example.internal
MQTT_PORT=8883
MQTT_USER=<mqtt-user>
MQTT_PASSWORD=<mqtt-password>
MQTT_TLS=true
MQTT_TLS_CA=/etc/ssl/certs/ca.pem
MQTT_CLIENT_ID=energy-gateway-01
MQTT_TOPIC_PREFIX=plant/energy
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_TIMEOUT=5

MODBUS_HOST=192.168.1.30
MODBUS_PORT=502
MODBUS_TIMEOUT=3
MODBUS_REGISTER_TYPE=input

# Register maps are per meter; values are placeholder unit ids/addresses/scales.
MODBUS_METERS={"FEEDER-01":{"unit_id":1,"registers":{"voltage_v":{"address":0,"scale":0.1},"current_a":{"address":1,"scale":0.01},"power_kw":{"address":2,"scale":0.1},"energy_kwh":{"address":3,"scale":0.001},"power_factor":{"address":4,"scale":0.001},"frequency_hz":{"address":5,"scale":0.01}}},"HVAC-01":{"unit_id":2,"registers":{"voltage_v":{"address":0,"scale":0.1},"current_a":{"address":1,"scale":0.01},"power_kw":{"address":2,"scale":0.1},"energy_kwh":{"address":3,"scale":0.001},"power_factor":{"address":4,"scale":0.001},"frequency_hz":{"address":5,"scale":0.01}}},"LINE-01":{"unit_id":3,"registers":{"voltage_v":{"address":0,"scale":0.1},"current_a":{"address":1,"scale":0.01},"power_kw":{"address":2,"scale":0.1},"energy_kwh":{"address":3,"scale":0.001},"power_factor":{"address":4,"scale":0.001},"frequency_hz":{"address":5,"scale":0.01}}}}
